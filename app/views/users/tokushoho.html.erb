<%= render "shared/second-header" %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= stylesheet_link_tag 'user/tokushoho', media: 'all' %>
    <title>特定商取引に関する取引</title>
</head>
<body>

<div class="tokushoho-container">
  <h1 class="tokushoho-title">特定商取引に関する表記</h1>
  
  <table class="tokushoho-table">
    <tr>
      <th>販売業者</th>
      <td>株式会社FURIMA</td>
    </tr>
    <tr>
      <th>運営責任者</th>
      <td>山田 太郎</td>
    </tr>
    <tr>
      <th>所在地</th>
      <td>東京都渋谷区神南1丁目23-5 フリマビル5F</td>
    </tr>
    <tr>
      <th>電話番号</th>
      <td>03-1234-5678（平日9:00〜18:00）</td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><a href="mailto:info@furima.co.jp">info@furima.co.jp</a></td>
    </tr>
    <tr>
      <th>販売価格</th>
      <td>各商品ページに記載</td>
    </tr>
    <tr>
      <th>商品代金以外の必要料金</th>
      <td>
        ・消費税<br>
        ・送料（各商品ページに記載）<br>
        ・振込手数料（銀行振込の場合）
      </td>
    </tr>
    <tr>
      <th>お支払い方法</th>
      <td>
        ・クレジットカード<br>
        ・銀行振込<br>
        ・FURIMAポイント
      </td>
    </tr>
    <tr>
      <th>お支払い期限</th>
      <td>商品購入後、7日以内にお支払いください。</td>
    </tr>
    <tr>
      <th>引き渡し時期</th>
      <td>ご注文確認後、通常2〜5営業日以内に発送</td>
    </tr>
    <tr>
      <th>返品・交換について</th>
      <td>
        ・商品の特性上、返品は原則受け付けておりません。<br>
        ・商品に欠陥がある場合のみ、商品到着後7日以内にご連絡ください。
      </td>
    </tr>
    <tr>
      <th>資格・免許</th>
      <td>必要なし</td>
    </tr>
  </table>
</div>

</body>
<%= render "shared/second-footer" %>